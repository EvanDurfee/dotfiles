# Colored Manpages
man() {
	LESS_TERMCAP_mb=$'\E[01;32m' \
	LESS_TERMCAP_md=$'\E[01;32m' \
	LESS_TERMCAP_me=$'\E[0m' \
	LESS_TERMCAP_se=$'\E[0m' \
	LESS_TERMCAP_so=$'\E[01;47;34m' \
	LESS_TERMCAP_ue=$'\E[0m' \
	LESS_TERMCAP_us=$'\E[01;36m' \
	GROFF_NO_SGR=1 \
	command man "$@"
}

